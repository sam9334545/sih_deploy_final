# ==============================================================================
# SIH26006 Intelligent Freight Forecasting — Production Deployment Environment
# ==============================================================================

# Application & Serving Mode (Production mode enforces strict ML availability)
DEMO_MODE=false
REQUIRE_V2_FORECAST=true
LOG_LEVEL=warning

# Network & Host
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://charter.yourdomain.gov.in,https://sih26006.yourdomain.org

# Production Database (PostgreSQL recommended for multi-tenant enterprise deployment)
DATABASE_URL=postgresql+psycopg2://charter_admin:SECURE_PASSWORD@postgres-host:5432/charter_intelligence

# Container ML Artifact Paths (Mounted or Packaged into image)
FORECAST_V2_ROOT=/app/ml-work
FORECAST_V2_ARTIFACTS=/app/ml-work/models/saved_models/v2

# Simulation & Risk Defaults
SIMULATION_SEED=42
N_SIMULATIONS_DEFAULT=1000

# Frontend Base URL (Points to public API gateway or ingress)
VITE_API_BASE_URL=https://api.charter.yourdomain.gov.in
