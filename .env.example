# ==============================================================================
# SIH26006 Intelligent Freight Forecasting — Development Environment
# ==============================================================================

# Application & Serving Mode
DEMO_MODE=true
REQUIRE_V2_FORECAST=false
LOG_LEVEL=info

# Network & Host
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Persistence (SQLite for local development/demo)
DATABASE_URL=sqlite:///./charter.db

# Machine Learning Artifact Roots (Auto-discovered if left blank)
FORECAST_V2_ROOT=
FORECAST_V2_ARTIFACTS=

# Simulation & Seed
SIMULATION_SEED=42
N_SIMULATIONS_DEFAULT=500

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000
